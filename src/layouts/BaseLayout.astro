---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { getSiteContext } from "@js/getSiteContext";

import Meta from "@components/Meta/Meta.astro";
import DynamicHeader from "@components/Header/DynamicHeader.astro";
import Footer from "@components/Footer/Footer.astro";
import "@styles/root.less";

interface Props {
  title: string;
  description: string;
}

const { description, title } = Astro.props as Props;

const { content, lang, alternates, locale, currentHreflang, ogLocale } = await getSiteContext(
  Astro.url,
);
---

<html lang={lang}>
  <head>
    <!-- SEO Meta Tags -->
    <Meta
      title={title}
      description={description}
      locale={locale}
      currentHreflang={currentHreflang}
      ogLocale={ogLocale}
      alternates={alternates}
    >
      <slot name="schema" slot="schema" />
    </Meta>

    <!-- Astro custom Font API -->
    <Font cssVariable="--font-primary" preload />

    <!-- View Transitions support -->
    <ClientRouter />

    <!-- Sitewide Scripts -->
    <script src="@assets/js/nav.js"></script>

    <!-- FOUC prevention: applies dark-mode class before first paint.
		     Reads cs-theme (set by ThemeSelect or DarkModeToggle) and falls
		     back to the legacy "theme" key used by the Intermediate kit. -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("cs-theme");
        var isDark;
        if (stored === "dark") {
          isDark = true;
        } else if (stored === "light" || stored === "") {
          isDark = false;
        } else {
          // Not set or any unexpected value — fall back to legacy key, then system pref
          var legacy = localStorage.getItem("theme");
          if (legacy === "dark") {
            isDark = true;
          } else if (legacy === "light") {
            isDark = false;
          } else {
            isDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          }
        }
        if (isDark) document.body?.classList.add("dark-mode");
      })();
    </script>
  </head>
  <body>
    <!-- Screen reader skip main nav -->
    <a class="skip" href="#main">{content.common.skipLink}</a>

    <DynamicHeader />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<!-- Re-apply theme after each View Transition page swap -->
<script is:inline>
  document.addEventListener("astro:after-swap", function () {
    var stored = localStorage.getItem("cs-theme");
    var isDark;
    if (stored === "dark") {
      isDark = true;
    } else if (stored === "light" || stored === "") {
      isDark = false;
    } else {
      var legacy = localStorage.getItem("theme");
      if (legacy === "dark") {
        isDark = true;
      } else if (legacy === "light") {
        isDark = false;
      } else {
        isDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      }
    }
    isDark ? document.body.classList.add("dark-mode") : document.body.classList.remove("dark-mode");
  });
</script>
