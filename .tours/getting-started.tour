{
	"$schema": "https://aka.ms/codetour-schema",
	"title": "Getting Started - Initial Configuration",
	"steps": [
		{
			"file": "src/data/client.ts",
			"description": "Update the business name, email, phone, address and other business details here. This object is used in <Footer /> for example",
			"line": 2
		},
		{
			"file": "src/data/siteConfig.ts",
			"description": "Site/SEO config lives here. The **SITE** object contains domain and description info used throughout for canonical URLs and meta tags. Don't forget to update your social image in **OG**.",
			"line": 1
		},
		{
			"file": "astro.config.ts",
			"description": "Update the **site** URL to your actual domain before deployment. This is used for generating the sitemap and canonical URLs. For local development, you can leave it as-is, but change it before going live.",
			"line": 7
		},
		{
			"file": "src/styles/root.less",
			"description": "Want to change colors, fonts, or spacing? The CSS variables defined here control the look across all components. Change **--primary**, **--secondary**, **--headerColor**, etc. to customize your site's appearance. These variables are used throughout all CodeStitch components.",
			"line": 10
		},
		{
			"file": "src/components/Settings/Settings.astro",
			"description": "Swap the header's dark mode toggle or language switcher by changing the import here — no prop wiring needed.\n\n- Dark mode: `DarkModeToggle` (simple button) or `ThemeSelect` (Light/Dark/Auto dropdown, default) in `src/features/darkmode/`\n- Language switcher: `TwoLocalesSelect` (default) or `MultiLocalesSelect` in `src/features/i18n/LanguageSwitch/`\n\nDelete a line entirely to remove that feature from the header.",
			"line": 1
		},
		{
			"file": "package.json",
			"description": "Key commands:\n\n- `npm run dev` — start the dev server\n- `npm run setup-project` — choose which features to keep (i18n, CMS, demo, dark mode) and configure locales\n- `npm run create-page` — scaffold a new page for every locale\n\nNeed to reconfigure or remove something later? Run the matching script directly, e.g. `node scripts/remove-i18n.js` or `node scripts/config-i18n.js`.",
			"line": 5
		}
	]
}